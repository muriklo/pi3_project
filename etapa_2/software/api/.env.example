# ---- Aplicacao ----
SYSCARE_ENV=dev
SYSCARE_DATABASE_URL=sqlite:///./syscare.db
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
SYSCARE_JWT_SECRET=troque-este-valor-em-producao
SYSCARE_JWT_EXPIRE_MINUTES=10080

# ---- Regras de alerta ----
# Janela (s) em que dois POSTs do mesmo (device, seq) sao o MESMO alerta.
SYSCARE_DEDUP_WINDOW_SECONDS=180
# Tolerancia (s) do timestamp do evento em relacao ao relogio do servidor.
SYSCARE_MAX_EVENT_SKEW_SECONDS=900
# Reenvia o alerta se ninguem confirmar dentro deste prazo.
SYSCARE_ESCALATION_SECONDS=60
SYSCARE_ESCALATION_MAX_ROUNDS=3
# Exige HMAC valido da pulseira (deixe false ate o firmware implementar).
SYSCARE_REQUIRE_HMAC=false

# ---- Firebase Cloud Messaging (gratis) ----
# Caminho do JSON da service account baixado no console do Firebase.
# Se vazio, o dispatcher usa o provider "console" (so loga) e a API roda sem Firebase.
SYSCARE_FCM_CREDENTIALS_FILE=
SYSCARE_FCM_PROJECT_ID=

# ---- SMS (canal caro: so para cuidador sem smartphone ou escalonamento) ----
# none = desligado | dryrun = monta e loga sem enviar | twilio = envio real
SYSCARE_SMS_PROVIDER=none
SYSCARE_TWILIO_ACCOUNT_SID=
SYSCARE_TWILIO_AUTH_TOKEN=
SYSCARE_TWILIO_FROM_NUMBER=
# Rodada de escalonamento a partir da qual o SMS entra (0 = junto com o push).
# Cuidador sem token de push recebe SMS na rodada 0 de qualquer forma.
SYSCARE_SMS_FROM_ESCALATION_ROUND=1
