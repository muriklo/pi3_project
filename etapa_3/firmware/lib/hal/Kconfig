# SysCare - HAL (camada de abstracao do hardware)
#
# Os simbolos sao ocultos: cada driver seleciona o que usa.

config SYSCARE_HAL
	bool
	help
	  Habilitado quando algum componente da HAL e usado.

config SYSCARE_HAL_SPI
	bool
	select SYSCARE_HAL
	select SPI
	help
	  HAL SPI generica sobre spi_dt_spec. Selecionada pelos drivers que
	  usam SPI.

config SYSCARE_HAL_GPIO
	bool
	select SYSCARE_HAL
	select GPIO
	help
	  HAL GPIO (entrada com interrupcao) sobre gpio_dt_spec. Selecionada
	  pelos drivers que usam pinos de interrupcao.
