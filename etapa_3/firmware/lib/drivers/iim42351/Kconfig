# SysCare - driver do acelerometro IIM-42351

menuconfig SYSCARE_IIM42351
	bool "Driver do acelerometro IIM-42351"
	default y
	depends on DT_HAS_INVENSENSE_IIM42351_ENABLED
	select SYSCARE_HAL_SPI
	select REGULATOR if $(dt_compat_any_has_prop,$(DT_COMPAT_INVENSENSE_IIM42351),vdd-supply)
	select REGULATOR if $(dt_compat_any_has_prop,$(DT_COMPAT_INVENSENSE_IIM42351),vddio-supply)
	help
	  Driver proprio do SysCare para o acelerometro IIM-42351 (SPI).
	  E habilitado automaticamente quando o devicetree tem um no com
	  compatible "invensense,iim42351" e status "okay".

if SYSCARE_IIM42351

module = SYSCARE_IIM42351
module-str = iim42351
source "subsys/logging/Kconfig.template.log_config"

endif # SYSCARE_IIM42351
