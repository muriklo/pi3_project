# Configuracao da API no servidor da nuvem (/opt/syscare/api/.env).
# Copia do arquivo em uso, sem a chave do JWT. Gere a chave no proprio servidor:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# O arquivo real fica com permissao 600 e dono syscare; nunca vai para o git.
SYSCARE_ENV=prod
SYSCARE_DATABASE_URL=sqlite:////opt/syscare/data/syscare.db
SYSCARE_JWT_SECRET=<gerada no servidor>
SYSCARE_JWT_EXPIRE_MINUTES=10080
SYSCARE_DEDUP_WINDOW_SECONDS=180
SYSCARE_MAX_EVENT_SKEW_SECONDS=900
SYSCARE_TELEMETRY_BUCKET_SECONDS=60
SYSCARE_ESCALATION_SECONDS=60
SYSCARE_ESCALATION_MAX_ROUNDS=3
# Continua false ate o firmware integrado assinar os anuncios.
SYSCARE_REQUIRE_HMAC=false
SYSCARE_FCM_CREDENTIALS_FILE=/opt/syscare/secrets/firebase.json
# O SMS sai pelo proprio celular (Camada 3); a API nao envia SMS.
SYSCARE_SMS_PROVIDER=none
SYSCARE_SMS_FROM_ESCALATION_ROUND=1
