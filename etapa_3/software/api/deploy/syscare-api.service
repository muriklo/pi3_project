[Unit]
Description=SysCare API
After=network-online.target
Wants=network-online.target

[Service]
User=syscare
Group=syscare
WorkingDirectory=/opt/syscare/api
ExecStart=/opt/syscare/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/syscare/data

[Install]
WantedBy=multi-user.target
